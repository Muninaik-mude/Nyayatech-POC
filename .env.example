CAPTCHA_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_CAPTCHA_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
DEFAULT_TIER=auto
LIGHTPANDA_URL=ws://127.0.0.1:9222
PORT=3000
RUNS_DIR=./runs

# --- Security (all optional on a laptop; required if you expose the server) ---
# API_KEYS=key1,key2           # require "Authorization: Bearer <key>" or "X-API-Key" on /api/*
# HOST=127.0.0.1               # any other address makes API_KEYS mandatory
# CORS_ORIGINS=https://app.example.com   # default: no cross-origin access
# RATE_LIMIT_PER_MIN=30        # per key, on routes that cost a captcha solve
# CAPTCHA_DAILY_BUDGET=2000    # max paid LLM captcha calls per UTC day (0 = unlimited)
# ENABLE_DEBUG=1               # enables /api/debug/* (fetches *.gov.in URLs)
# ENABLE_LIGHTPANDA=1          # AGPL-3.0 tier, off by default
# CNR_CACHE_MINUTES=15         # reuse a CNR result this long
# DOWNLOAD_ORDERS=0            # 0 = do not download order PDFs
